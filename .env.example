# Demo mode (default): every /api request is answered from in-memory mock data (src/api/mock),
# so the app runs with no backend. Changes reset on reload.
# Set to false to talk to the real backend instead.
VITE_USE_MOCK_DATA=true

# Real backend only (VITE_USE_MOCK_DATA=false). Leave empty in development: Vite proxies /api to
# API_PROXY_TARGET (default http://127.0.0.1:8020). Set the backend origin for production builds.
VITE_API_BASE_URL=
